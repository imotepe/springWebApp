@startuml
left to right direction
hide methods
skinparam classAttributeIconSize 0
skinparam dpi 150
skinparam shadowing false
skinparam packageStyle rectangle

package "Organizations" {
  class Organization {
    +id: String
    +name: String
    +marketingName: String
    +industry: String
    +type: String
    +phone: String
    +address: Address
    +location: GeoLocation
    +scheduleConfig: ScheduleConfig
    +createdBy: String
    +createdAt: LocalDateTime
    +mapsLink: String
    +facebookPage: String
    +facebookGroup: String
    +instagram: String
    +whatsappContact: String
    +mapsQrCode: String
    +facebookPageQrCode: String
    +facebookGroupQrCode: String
    +instagramQrCode: String
    +whatsappMessageQrCode: String
    +whatsappCallQrCode: String
    +logoImage: String
  }

  class OrganizationType {
    +id: String
    +name: String
    +description: String
    +createdBy: String
    +createdAt: LocalDateTime
  }
}

package "Location" {
  class Address {
    +street: String
    +city: String
    +state: String
    +postalCode: String
    +country: String
  }

  class GeoLocation {
    +latitude: Double
    +longitude: Double
  }
}

package "Scheduling" {
  class ScheduleConfig {
    +workingDays: Set<DayOfWeek>
    +businessHours: Map<DayOfWeek, List<TimeWindow>>
    +breaks: Map<DayOfWeek, List<TimeWindow>>
    +holidays: List<Holiday>
  }

  class TimeWindow {
    +start: LocalTime
    +end: LocalTime
  }

  class Holiday {
    +date: LocalDate
    +allDay: boolean
    +closedWindows: List<TimeWindow>
    +description: String
  }
}

package "Appointments" {
  class AppointmentType {
    +id: String
    +orgId: String
    +name: String
    +category: String
    +defaultDurationMinutes: Integer
    +allowedDurations: List<Integer>
    +requiresResource: boolean
    +active: boolean
    +allowedDaysOfWeek: Set<DayOfWeek>
    +allowedTimeWindows: Map<DayOfWeek, List<TimeWindow>>
  }

  class Appointment {
    +id: String
    +orgId: String
    +customerId: String
    +appointmentTypeId: String
    +resourceId: String
    +startTime: LocalDateTime
    +endTime: LocalDateTime
    +status: AppointmentStatus
    +notes: String
    +events: List<AppointmentEvent>
  }

  class AppointmentEvent {
    +id: String
    +type: AppointmentEventType
    +status: AppointmentStatus
    +comment: String
    +createdBy: String
    +createdAt: LocalDateTime
  }

  enum AppointmentEventType {
    CUSTOMER_COMMENT
    CUSTOMER_CANCEL
    CUSTOMER_UPDATE
    INTERNAL_NOTE
    PRACTITIONER_NOTE
  }

  enum AppointmentStatus {
    SCHEDULED
    COMPLETED
    CANCELLED
  }
}

package "Customers & People" {
  class Customer {
    +id: String
    +orgId: String
    +name: String
    +firstName: String
    +email: String
    +phone: String
    +dateOfBirth: LocalDate
    +notes: String
    +interactions: List<CustomerInteraction>
  }

  class CustomerInteraction {
    +id: String
    +appointmentId: String
    +type: AppointmentEventType
    +status: AppointmentStatus
    +comment: String
    +createdBy: String
    +createdAt: LocalDateTime
  }

  note right of CustomerInteraction
    createdBy stores the user id of the creator
  end note

  class User {
    +id: String
    +username: String
    +firstName: String
    +lastName: String
    +email: String
    +password: String
    +roles: Set<UserRole>
    +homeOrganizationId: String
    +status: UserStatus
    +expiresAt: LocalDateTime
    +createdAt: LocalDateTime
  }

enum UserRole {
  SUPER_PLATFORM_ADMIN
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  SERVICE_MANAGER
  AGENT
  AUDITOR
  PRACTITIONER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  BLOCKED
}
}

package "Operations" {
  class Resource {
    +id: String
    +orgId: String
    +name: String
    +type: String
    +allowedAppointmentTypeIds: Set<String>
    +scheduleOverride: ScheduleConfig
    +capacity: Integer
    +active: boolean
    +kind: ResourceKind
    +practitionerUserId: String
  }

  enum ResourceKind {
    HUMAN
    ASSET
  }

  class AvailabilitySlot {
    +start: LocalDateTime
    +end: LocalDateTime
  }
}

package "Billing" {
  class Plan {
    +id: String
    +code: String
    +name: String
    +description: String
    +priceAmount: BigDecimal
    +priceCurrency: String
    +billingCycle: BillingCycle
    +trialDays: Integer
    +active: boolean
    +createdAt: LocalDateTime
  }

  class Subscription {
    +id: String
    +orgId: String
    +planCode: String
    +status: SubscriptionStatus
    +startAt: LocalDateTime
    +endsAt: LocalDateTime
    +createdBy: String
    +createdAt: LocalDateTime
  }

  enum BillingCycle {
    MONTHLY
    ANNUAL
  }

  enum SubscriptionStatus {
    PREACTIVE
    TRIAL
    ACTIVE
    SUSPENDED
    CANCELLED
    EXPIRED
  }
}

Organization "1" o- "1" ScheduleConfig : scheduleConfig
Resource "0..1" o- "1" ScheduleConfig : scheduleOverride
ScheduleConfig "1" o- "*" TimeWindow : businessHours/breaks
ScheduleConfig "1" o- "*" Holiday : holidays
Holiday "1" o- "*" TimeWindow : closedWindows

Organization "*" --> "1" OrganizationType : type (name)
Organization "1" o- "1" Address : address
Organization "0..1" o- "1" GeoLocation : location
Appointment "*" --> "1" Organization : orgId
Appointment "*" --> "1" Customer : customerId
Appointment "*" --> "1" AppointmentType : appointmentTypeId
Appointment "*" --> "0..1" Resource : resourceId
Appointment ..> AppointmentStatus
Appointment "1" o- "*" AppointmentEvent : events
AppointmentEvent ..> AppointmentEventType
AppointmentEvent ..> AppointmentStatus

AppointmentType "*" --> "1" Organization : orgId
AppointmentType ..> TimeWindow : allowedTimeWindows
Resource "*" --> "1" Organization : orgId
Resource "0..1" --> "1" User : practitioner
Resource ..> AppointmentType : allowedAppointmentTypeIds (IDs)
Resource ..> ResourceKind : kind

AvailabilitySlot ..> Appointment : computed from

Customer "1" o- "*" CustomerInteraction : interactions
CustomerInteraction --> Appointment : appointmentId
CustomerInteraction ..> AppointmentEventType
CustomerInteraction ..> AppointmentStatus
User "*" --> "*" UserRole : roles
User "*" <-- "0..1" Resource : practitioner
User "*" --> "0..1" Organization : homeOrganization
User "*" --> "1" UserStatus : status
Subscription "1" --> "1" Organization : orgId
Subscription ..> SubscriptionStatus
Plan "1" --> "*" Subscription : planCode
Plan ..> BillingCycle

@enduml
