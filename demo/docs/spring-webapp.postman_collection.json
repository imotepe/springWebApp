              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"claire.dubois\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    try {",
                  "        const data = pm.response.json();",
                  "        if (data.token) {",
                  "            pm.collectionVariables.set(\"authToken\", data.token);",
                  "            console.log(\"Auth token saved to collection variables\");",
                  "        }",
                  "    } catch (err) {",
                  "        console.warn(\"Unable to parse auth response\", err);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
